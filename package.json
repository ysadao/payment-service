{
  "name": "payment-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ledger — FinTech operator console with Prisma/Postgres, full auth, idempotent payments, and an immutable ledger.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "prisma generate && tsc && npm run build --prefix web",
    "start": "node dist/index.js",
    "test": "node --import ./tests/preload.mjs --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
